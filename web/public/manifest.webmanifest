{
  "name": "Panthera Claw",
  "short_name": "Claw",
  "description": "Confira se um comprovante de Pix é falso, sem ele sair do seu aparelho.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0b0b",
  "theme_color": "#0b0b0b",
  "icons": [
    { "src": "icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icone-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "arquivo", "accept": ["image/*", "application/pdf", ".pdf"] }]
    }
  }
}
